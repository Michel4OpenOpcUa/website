---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProtocols } from '../../data/projects';
import { absolute, breadcrumbs, orgRef } from '../../data/seo';
import {
	ecosystem,
	ecosystemProtocols,
	byProtocol,
	formatCount,
	formatDay,
	licenseFamily,
	maintenanceLabels,
	stats,
	typeLabels,
	typeOrder,
} from '../../data/ecosystem';
import { ELBOW, H, HUB, RX, RY, W, layout } from '../../data/ecosystem-layout';

const icons = Object.fromEntries((await getProtocols()).map((p) => [p.id, p.data.icon]));
const maps = ecosystemProtocols.map((p) => ({ protocol: p, ...layout(p.id) }));
const all = ecosystem.implementations;
const languages = [...new Set(all.flatMap((i) => i.languages))].sort((a, b) => a.localeCompare(b));
const families = ['Permissive', 'Weak copyleft', 'Copyleft', 'Source-available', 'Commercial'];
const statuses = ['active', 'slowing', 'quiet', 'archived', 'deprecated', 'discontinued'];
const short = (s: string, n = 24) => (s.length > n ? `${s.slice(0, n - 1)}…` : s);
const hubText = (h: { type: keyof typeof typeLabels; count: number }) => `${typeLabels[h.type].split(' ')[0]} · ${h.count}`;
const pill = (h: Parameters<typeof hubText>[0]) => hubText(h).length * 8 + 24;
const verified = formatDay(ecosystem.verified);

// The client script reads everything it shows from this payload.
const payload = {
	protocols: Object.fromEntries(ecosystemProtocols.map((p) => [p.id, p.name])),
	types: typeLabels,
	maintenance: maintenanceLabels,
	items: all.map((i) => ({ ...i, family: licenseFamily(i.license) })),
};

const schema = [
	breadcrumbs([{ name: 'Ecosystem map', path: '/ecosystem/' }]),
	{
		'@type': 'Dataset',
		'@id': `${absolute('/ecosystem/')}#dataset`,
		name: ecosystem.title,
		description: `An open, source-backed registry of ${stats.implementations} open-source and commercial implementations of industrial protocol stacks (${ecosystemProtocols.map((p) => p.name).join(', ')}), with language, licence, roles, capabilities, maintenance status and latest release, each checked at its publishing source.`,
		url: absolute('/ecosystem/'),
		dateModified: ecosystem.verified,
		license: 'https://opensource.org/licenses/MIT',
		isAccessibleForFree: true,
		creator: orgRef,
		publisher: orgRef,
		keywords: ['industrial protocols', 'OT', 'protocol stacks', 'open source', ...ecosystemProtocols.map((p) => p.name)],
		variableMeasured: ['protocol', 'implementation type', 'programming language', 'licence', 'roles', 'capabilities', 'latest release', 'maintenance status'],
		distribution: { '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: absolute('/ecosystem.json') },
	},
];
---

<BaseLayout
	title="OT protocol ecosystem map"
	description={`Who implements Modbus, OPC UA, BACnet, IEC 104, IEC 61850, Siemens S7, OpenADR, OCPP and DNP3: ${stats.implementations} open-source and commercial stacks with language, licence, roles and latest release.`}
	image="/ecosystem-card.png"
	imageAlt="The OT protocol ecosystem map: protocols in the middle, implementations around them"
	pageType="CollectionPage"
	schema={schema}
>
	<section class="eco-head">
		<div class="ot-container wide">
			<span class="ot-label accent">Ecosystem map · verified {verified}</span>
			<h1>The industrial protocol stack landscape</h1>
			<p class="lead">
				An open, community-maintained map of the implementations connecting operational technology. Pick a protocol, then pick a
				stack to see its language, licence, roles and latest release, and jump straight to its source.
			</p>
			<dl class="stats">
				<div><dt>Implementations</dt><dd>{stats.implementations}</dd></div>
				<div><dt>Protocols</dt><dd>{stats.protocols}</dd></div>
				<div><dt>Languages</dt><dd>{stats.languages}</dd></div>
				<div><dt>Commercial SDKs</dt><dd>{stats.commercial}</dd></div>
				<div><dt>Tested in our interop suites</dt><dd>{stats.interop}</dd></div>
			</dl>
		</div>
	</section>

	<div class="ot-container wide eco" id="eco">
		<div class="tabs" role="tablist" aria-label="Protocol">
			{maps.map(({ protocol }, i) => (
				<button type="button" role="tab" id={`tab-${protocol.id}`} data-protocol={protocol.id} aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`panel-${protocol.id}`}>
					{icons[protocol.id] && <img src={`/icons/${icons[protocol.id]}.svg`} alt="" width="22" height="22" />}
					<span>{protocol.name}</span>
					<span class="count">{byProtocol(protocol.id).length}</span>
				</button>
			))}
		</div>

		<form class="filters" aria-label="Filter implementations" onsubmit="return false">
			<label class="search">
				<span class="sr-only">Search</span>
				<input type="search" name="q" placeholder="Search name, language, licence…" autocomplete="off" />
			</label>
			<label>
				<span class="ot-label">Language</span>
				<select name="language">
					<option value="">Any</option>
					{languages.map((l) => <option>{l}</option>)}
				</select>
			</label>
			<label>
				<span class="ot-label">Licence</span>
				<select name="family">
					<option value="">Any</option>
					{families.map((f) => <option>{f}</option>)}
				</select>
			</label>
			<label>
				<span class="ot-label">Activity</span>
				<select name="maintenance">
					<option value="">Any</option>
					{statuses.map((s) => <option value={s}>{maintenanceLabels[s]}</option>)}
				</select>
			</label>
			<label class="check">
				<input type="checkbox" name="interop" />
				<span>In an OT Fabric interop suite</span>
			</label>
		</form>

		<div class="stage">
			<div class="maps">
				{maps.map(({ protocol, cx, cy, hubs, leaves, links }, i) => (
					<section class:list={['map', { 'is-active': i === 0 }]} id={`panel-${protocol.id}`} role="tabpanel" aria-labelledby={`tab-${protocol.id}`} data-protocol={protocol.id}>
						<div class="svg-pan"><svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`${protocol.name}: ${leaves.length} implementations grouped by type`}>
							<g class="grid" aria-hidden="true">
								{[HUB, ELBOW, 1].map((f) => <ellipse cx={cx} cy={cy} rx={RX * f} ry={RY * f} />)}
							</g>
							<g class="branches" aria-hidden="true">
								{hubs.map((h) => <line class={`b-${h.type}`} x1={cx} y1={cy} x2={h.x} y2={h.y} />)}
								{leaves.map((l) => <path class={`b-${l.impl.type}`} d={l.path} data-edge={l.impl.id} />)}
							</g>
							<g class="links" aria-hidden="true">
								{links.map((k) => <path d={k.path} data-from={k.from} data-to={k.to} />)}
							</g>
							<g class="hubs" aria-hidden="true">
								{hubs.map((h) => (
									<g class={`hub b-${h.type}`} transform={`translate(${h.x} ${h.y})`}>
										<rect x={-pill(h) / 2} y="-14" width={pill(h)} height="28" rx="14" />
										<text y="4.5">{hubText(h)}</text>
									</g>
								))}
							</g>
							<g class="core" aria-hidden="true">
								<circle cx={cx} cy={cy} r="64" />
								<circle class="ring" cx={cx} cy={cy} r="72" />
								<text class="core-name" x={cx} y={cy + 2}>{protocol.name.replace(' / MMS', '')}</text>
								<text class="core-sub" x={cx} y={cy + 24}>{leaves.length} stacks</text>
							</g>
							<g class="leaves">
								{leaves.map((l) => (
									<a
										href={`#impl-${l.impl.id}`}
										class:list={['leaf', `t-${l.impl.type}`, `m-${(l.impl.maintenance ?? 'unknown').replace('/', '')}`, { otf: l.impl.otfabric }]}
										data-impl={l.impl.id}
										aria-label={`${l.impl.name}, ${l.impl.languages.join(', ')}, ${l.impl.license}`}
									>
										<circle class="halo" cx={l.x} cy={l.y} r="18" />
										<circle class="dot" cx={l.x} cy={l.y} r={l.impl.otfabric ? 10 : 8} />
										{l.impl.interop && !l.impl.otfabric && <circle class="tested" cx={l.x} cy={l.y} r="13" />}
										{l.leader && <path class="leader" d={l.leader} />}
										<text x={l.lx} y={l.ly - 1} text-anchor={l.side === 'right' ? 'start' : 'end'}>
											<tspan class="name">{short(l.impl.name)}</tspan>
											<tspan class="meta" x={l.lx} dy="18">{short(`${l.impl.languages.join(', ')} · ${l.impl.license.replace(' WITH GCC-exception-2.0', '+exc.')}`, 30)}</tspan>
										</text>
									</a>
								))}
							</g>
						</svg></div>
						<p class="summary">{protocol.summary} <span class="ot-label">Focus: {protocol.focus}</span></p>
					</section>
				))}
				<ul class="legend" aria-label="Legend">
					{typeOrder.map((t) => <li><i class={`sw b-${t}`} />{typeLabels[t]}</li>)}
					<li><i class="sw ring" />Tested in an OT Fabric interop suite</li>
					<li><i class="sw otf" />OT Fabric</li>
					<li><i class="sw link" />Builds on or continues</li>
					<li><i class="sw hollow" />Quiet, archived or deprecated</li>
				</ul>
			</div>

			<aside class="detail" aria-live="polite">
				<div class="detail-empty">
					<span class="ot-label">How to read the map</span>
					<p>Each dot is one implementation. Branches group them as independent stacks, derived libraries and bindings, commercial SDKs, and legacy or reference code.</p>
					<p>Dots are the same size on purpose: popularity is a property here, not a ranking. A mature C stack with 200 stars may run in more field devices than a library with thousands.</p>
					<p class="hint">Select a dot or a row to see the details.</p>
				</div>
				<div class="detail-body" hidden></div>
			</aside>
		</div>

		<div class="table-wrap">
			<table class="eco-table">
				<thead>
					<tr>
						<th scope="col">Implementation</th>
						<th scope="col">Type</th>
						<th scope="col">Language</th>
						<th scope="col">Licence</th>
						<th scope="col">Latest release</th>
						<th scope="col">Roles</th>
						<th scope="col">Activity</th>
						<th scope="col" class="num">Stars</th>
					</tr>
				</thead>
				<tbody>
					{all.map((i) => (
						<tr id={`impl-${i.id}`} data-impl={i.id} data-protocol={i.protocol} class:list={{ otf: i.otfabric, 'is-hidden': i.protocol !== maps[0].protocol.id }}>
							<th scope="row">
								<a href={i.url} rel="noopener">{i.name}</a>
								{i.otfabric && <span class="tag">OT Fabric</span>}
								{i.emerging && <span class="tag soft">Emerging</span>}
							</th>
							<td>{typeLabels[i.type].split(' ')[0]}</td>
							<td>{i.languages.join(', ')}</td>
							<td><code>{i.license}</code>{i.commercialLicense && <span class="plus" title="Commercial licence also available"> +commercial</span>}</td>
							<td>{i.release ? <><code>{i.release.version}</code> <span class="muted">{formatDay(i.release.date) ?? i.release.source}</span></> : <span class="muted">No release</span>}</td>
							<td>{(i.roles ?? []).join(', ') || '–'}</td>
							<td><span class={`st m-${(i.maintenance ?? 'unknown').replace('/', '')}`}>{maintenanceLabels[i.maintenance ?? ''] ?? 'Unknown'}</span></td>
							<td class="num">{formatCount(i.stars)}</td>
						</tr>
					))}
				</tbody>
			</table>
			<p class="empty" hidden>No implementation matches these filters.</p>
		</div>

		<section class="contribute">
			<div>
				<span class="ot-label accent">Open data</span>
				<h2>Missing a stack? Found a mistake?</h2>
				<p>
					The map is one JSON file in our website repository. Every entry carries its sources and the date we last checked it. Send a
					pull request with a new library, a commercial SDK, a correction or interop results, and the map updates on merge.
				</p>
				<ul class="notes">{ecosystem.notes.map((n) => <li>{n}</li>)}</ul>
			</div>
			<div class="actions">
				<a class="ot-btn primary" href="https://github.com/otfabric/website/blob/main/src/data/ecosystem.json">Edit the registry on GitHub</a>
				<a class="ot-btn" href="/blog/industrial-protocol-stack-landscape/">Read the research</a>
			</div>
		</section>
	</div>

	<script type="application/json" id="eco-data" set:html={JSON.stringify(payload)} />
</BaseLayout>

<script>
	type Item = Record<string, any>;
	const data = JSON.parse(document.getElementById('eco-data')!.textContent!) as {
		protocols: Record<string, string>;
		types: Record<string, string>;
		maintenance: Record<string, string>;
		items: Item[];
	};
	const items = new Map(data.items.map((i) => [i.id, i]));
	const root = document.getElementById('eco')!;
	const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role=tab]')];
	const maps = [...root.querySelectorAll<HTMLElement>('.map')];
	const rows = [...root.querySelectorAll<HTMLTableRowElement>('tbody tr')];
	const form = root.querySelector<HTMLFormElement>('.filters')!;
	const empty = root.querySelector<HTMLElement>('.detail-empty')!;
	const body = root.querySelector<HTMLElement>('.detail-body')!;
	const noMatch = root.querySelector<HTMLElement>('.empty')!;

	let protocol = tabs[0].dataset.protocol!;
	let selected: string | null = null;

	const esc = (s: unknown) =>
		String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
	const day = (d?: string) =>
		d ? new Date(`${d.slice(0, 10)}T00:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }) : '';
	const num = (n?: number | null) => (n == null ? '–' : n.toLocaleString('en-US'));
	const host = (u: string) => {
		try {
			return new URL(u).hostname.replace(/^www\./, '');
		} catch {
			return u;
		}
	};

	function matches(i: Item) {
		const f = new FormData(form);
		const q = String(f.get('q') ?? '').trim().toLowerCase();
		const language = f.get('language');
		const family = f.get('family');
		const maintenance = f.get('maintenance');
		if (q && ![i.name, i.repo, i.license, ...(i.languages ?? []), ...(i.capabilities ?? []), ...(i.roles ?? [])].join(' ').toLowerCase().includes(q)) return false;
		if (language && !i.languages.includes(language)) return false;
		if (family && i.family !== family) return false;
		if (maintenance && i.maintenance !== maintenance) return false;
		if (f.get('interop') && !i.interop) return false;
		return true;
	}

	function apply() {
		let shown = 0;
		for (const row of rows) {
			const i = items.get(row.dataset.impl!)!;
			const visible = row.dataset.protocol === protocol && matches(i);
			row.classList.toggle('is-hidden', !visible);
			row.classList.toggle('is-selected', row.dataset.impl === selected);
			if (visible) shown++;
		}
		noMatch.hidden = shown > 0;
		for (const leaf of root.querySelectorAll<SVGAElement>('.leaf')) {
			const id = leaf.dataset.impl!;
			leaf.classList.toggle('is-dim', !matches(items.get(id)!));
			leaf.classList.toggle('is-selected', id === selected);
		}
		for (const edge of root.querySelectorAll<SVGPathElement>('[data-edge]')) {
			edge.classList.toggle('is-on', edge.dataset.edge === selected);
		}
		for (const link of root.querySelectorAll<SVGPathElement>('.links path')) {
			link.classList.toggle('is-on', link.dataset.from === selected || link.dataset.to === selected);
		}
	}

	function show(next: string, push = true) {
		if (!data.protocols[next]) return;
		protocol = next;
		for (const t of tabs) t.setAttribute('aria-selected', String(t.dataset.protocol === next));
		for (const m of maps) m.classList.toggle('is-active', m.dataset.protocol === next);
		if (selected && items.get(selected)?.protocol !== next) select(null, false);
		apply();
		if (push) syncUrl();
	}

	function syncUrl() {
		const url = new URL(location.href);
		url.searchParams.set('protocol', protocol);
		if (selected) url.searchParams.set('stack', selected);
		else url.searchParams.delete('stack');
		url.hash = '';
		history.replaceState(null, '', url);
	}

	function row(label: string, value: string) {
		return value ? `<div><dt>${label}</dt><dd>${value}</dd></div>` : '';
	}

	function select(id: string | null, push = true) {
		selected = id;
		const i = id ? items.get(id) : null;
		empty.hidden = !!i;
		body.hidden = !i;
		if (i) {
			const rel = i.release
				? `<code>${esc(i.release.version)}</code> ${esc(day(i.release.date))} · ${i.release.url ? `<a href="${esc(i.release.url)}" rel="noopener">${esc(i.release.source)}</a>` : esc(i.release.source)}`
				: 'No tagged release';
			const pre = i.prerelease ? `<code>${esc(i.prerelease.version)}</code> ${esc(day(i.prerelease.date))}` : '';
			const ups = (i.upstream ?? [])
				.map((u: string) => items.get(u))
				.filter(Boolean)
				.map((u: Item) => `<button type="button" class="link" data-go="${esc(u.id)}">${esc(u.name)}</button>`)
				.join(', ');
			const downs = data.items
				.filter((d) => (d.upstream ?? []).includes(i.id))
				.map((d) => `<button type="button" class="link" data-go="${esc(d.id)}">${esc(d.name)}</button>`)
				.join(', ');
			const chips = (list: string[] = []) => list.map((c) => `<span class="chip">${esc(c)}</span>`).join('');
			body.innerHTML = `
				<span class="ot-label">${esc(data.protocols[i.protocol])} · ${esc(data.types[i.type])}</span>
				<h2>${esc(i.name)}</h2>
				<p class="badges">
					${i.otfabric ? '<span class="tag">OT Fabric</span>' : ''}
					${i.emerging ? '<span class="tag soft">Emerging</span>' : ''}
					<span class="st m-${esc((i.maintenance ?? 'unknown').replace('/', ''))}">${esc(data.maintenance[i.maintenance] ?? 'Activity unknown')}</span>
				</p>
				<dl>
					${row('Language', esc(i.languages.join(', ')))}
					${row('Licence', `<code>${esc(i.license)}</code>${i.commercialLicense ? ' · commercial licence available' : ''}`)}
					${row('Roles', chips(i.roles))}
					${row('Documented', chips(i.capabilities))}
					${row('Latest release', rel)}
					${row('Pre-release', pre)}
					${row('Last commit', esc(day(i.lastCommit)))}
					${row('Stars · forks', i.stars != null ? `${num(i.stars)} · ${num(i.forks)}` : '')}
					${row('Repository created', esc(day(i.repoCreated)))}
					${row('History since', esc(i.historySince))}
					${row('Builds on', ups)}
					${row('Built on by', downs)}
					${row('Relation', esc(i.relation))}
					${row('Interop', i.interop ? `<a href="https://github.com/otfabric/${esc(i.interop)}" rel="noopener">${esc(i.interop)}</a>` : '')}
				</dl>
				${i.notes ? `<p class="note">${esc(i.notes)}</p>` : ''}
				<div class="go">
					${i.url ? `<a class="ot-btn primary" href="${esc(i.url)}" rel="noopener">Open ${esc(i.repo ? 'repository' : host(i.url))} ↗</a>` : ''}
					${i.package && i.package !== i.url ? `<a class="ot-btn" href="${esc(i.package)}" rel="noopener">Package ↗</a>` : ''}
				</div>
				<p class="src ot-label">Verified ${esc(day(i.verified))} · ${i.sources.map((s: string) => `<a href="${esc(s)}" rel="noopener">${esc(host(s))}</a>`).join(' · ')}</p>`;
		}
		apply();
		if (push) {
			syncUrl();
			// Below the side-by-side breakpoint the panel sits under the map.
			if (i && !matchMedia('(min-width: 64rem)').matches) body.closest('.detail')!.scrollIntoView({ behavior: 'smooth', block: 'start' });
		}
	}

	tabs.forEach((t, n) => {
		t.addEventListener('click', () => show(t.dataset.protocol!));
		t.addEventListener('keydown', (e) => {
			const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
			if (!d) return;
			const next = tabs[(n + d + tabs.length) % tabs.length];
			next.focus();
			show(next.dataset.protocol!);
		});
	});
	root.addEventListener('click', (e) => {
		const target = e.target as Element;
		const go = target.closest<HTMLElement>('[data-go]');
		if (go) {
			const i = items.get(go.dataset.go!)!;
			if (i.protocol !== protocol) show(i.protocol);
			return select(i.id);
		}
		const leaf = target.closest<SVGAElement>('.leaf');
		if (leaf) {
			e.preventDefault();
			return select(leaf.dataset.impl === selected ? null : leaf.dataset.impl!);
		}
		const tr = target.closest<HTMLTableRowElement>('tbody tr');
		if (tr && !target.closest('a')) select(tr.dataset.impl!);
	});
	form.addEventListener('input', apply);

	const params = new URLSearchParams(location.search);
	const start = params.get('stack') ?? location.hash.replace(/^#impl-/, '');
	const startItem = items.get(start);
	show(startItem?.protocol ?? params.get('protocol') ?? protocol, false);
	if (startItem) select(startItem.id, false);
</script>

<style>
	.eco-head {
		padding-block: 3.5rem 2rem;
		border-bottom: 1px solid var(--ot-line);
		background:
			radial-gradient(60rem 26rem at 85% 10%, color-mix(in srgb, var(--ot-accent) 14%, transparent), transparent 70%),
			linear-gradient(to bottom, transparent, var(--ot-bg)),
			repeating-linear-gradient(90deg, var(--ot-line) 0 1px, transparent 1px 48px),
			repeating-linear-gradient(0deg, var(--ot-line) 0 1px, transparent 1px 48px);
	}
	.accent {
		color: var(--ot-accent);
	}
	h1 {
		margin: 0.6rem 0 0;
		max-width: 48rem;
		font-size: clamp(2.3rem, 5.5vw, 3.6rem);
		font-weight: 700;
	}
	.lead {
		max-width: 44rem;
		margin: 1rem 0 0;
		font-size: 1.15rem;
		color: var(--ot-muted);
	}
	.stats {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 2.5rem;
		margin: 2rem 0 0;
	}
	.stats div {
		display: flex;
		flex-direction: column-reverse;
	}
	.stats dt {
