---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/site/PageHeader.astro';
import PostList from '../../components/blog/PostList.astro';
import TagList from '../../components/blog/TagList.astro';
import { getPosts } from '../../data/blog';
import { absolute, breadcrumbs, orgRef } from '../../data/seo';

const posts = await getPosts();
const schema = [
	breadcrumbs([{ name: 'Blog', path: '/blog/' }]),
	{
		'@type': 'Blog',
		'@id': `${absolute('/blog/')}#blog`,
		name: 'OT Fabric blog',
		url: absolute('/blog/'),
		publisher: orgRef,
		blogPost: posts.map((post) => ({
			'@type': 'BlogPosting',
			headline: post.data.title,
			description: post.data.description,
			url: absolute(`/blog/${post.id}/`),
			datePublished: post.data.date.toISOString(),
		})),
	},
];
---

<BaseLayout title="Blog" description="Release notes, protocol deep dives and how OT Fabric is built." pageType="CollectionPage" schema={schema}>
	<PageHeader label="Blog" title="Notes from the fabric" lead="Release notes, protocol deep dives and how OT Fabric is built, by people and AI agents together." />
	<div class="ot-container">
		<TagList />
		<PostList posts={posts} />
	</div>
</BaseLayout>
