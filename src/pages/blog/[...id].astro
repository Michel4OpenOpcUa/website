---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getImage } from 'astro:assets';
import { formatDate, getPosts, readingTime, type Post } from '../../data/blog';
import { getProtocols } from '../../data/projects';
import { absolute, breadcrumbs, ogImage, orgRef } from '../../data/seo';

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post, i) => ({
		params: { id: post.id },
		props: { post, newer: posts[i - 1], older: posts[i + 1] },
	}));
}

interface Props {
	post: Post;
	newer?: Post;
	older?: Post;
}
const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const { data } = post;
// Social cards need a raster image; SVG covers fall back to the site image.
const cover =
	data.cover && data.cover.image.format !== 'svg'
		? (await getImage({ src: data.cover.image, width: 1200, format: 'png' })).src
		: undefined;
const url = absolute(`/blog/${post.id}/`);
// Tags that name a protocol tie the post to that protocol's page.
const protocols = (await getProtocols()).filter((p) => data.tags.includes(p.id));
const schema = [
	breadcrumbs([
		{ name: 'Blog', path: '/blog/' },
		{ name: data.title, path: `/blog/${post.id}/` },
	]),
	{
		'@type': 'BlogPosting',
		'@id': `${url}#article`,
		headline: data.title,
		description: data.description,
		url,
		mainEntityOfPage: { '@id': `${url}#webpage` },
		datePublished: data.date.toISOString(),
		dateModified: (data.updated ?? data.date).toISOString(),
		author: data.authors.map((name) => (name === 'OT Fabric' ? orgRef : { '@type': 'Person', name })),
		publisher: orgRef,
		image: absolute(cover ?? ogImage.src),
		keywords: data.tags.join(', '),
		...(protocols.length && {
			about: protocols.map((p) => ({ '@type': 'Thing', name: p.data.name, url: absolute(`/protocols/${p.id}/`) })),
		}),
		wordCount: (post.body ?? '').split(/\s+/).length,
		inLanguage: 'en',
	},
];
---

<BaseLayout
	title={data.title}
	description={data.description}
	type="article"
	image={cover}
	imageAlt={data.cover?.alt}
	article={{ published: data.date, modified: data.updated, tags: data.tags, authors: data.authors }}
	schema={schema}
>
	<article class="ot-container post">
		<header>
			<a class="back" href="/blog/">← Blog</a>
			<h1>{data.title}</h1>
			<p class="lead">{data.description}</p>
			<p class="ot-label byline">
				<time datetime={data.date.toISOString()}>{formatDate(data.date)}</time> · {data.authors.join(', ')} · {readingTime(post)} min read
			</p>
			{data.tags.length > 0 && (
				<ul class="tags">{data.tags.map((tag) => <li><a href={`/blog/tags/${tag}/`}>#{tag}</a></li>)}</ul>
			)}
		</header>

		{data.cover && <Image class="cover" src={data.cover.image} alt={data.cover.alt} width={1200} />}

		<div class="body">
			<div class="ot-prose"><Content /></div>
			{headings.filter((h) => h.depth === 2).length > 2 && (
				<nav class="toc" aria-label="On this page">
					<span class="ot-label">On this page</span>
					<ul>{headings.filter((h) => h.depth === 2).map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul>
				</nav>
			)}
		</div>

		<nav class="pager" aria-label="More posts">
			{older ? <a href={`/blog/${older.id}/`}><span class="ot-label">Older</span>{older.data.title}</a> : <span />}
			{newer && <a class="next" href={`/blog/${newer.id}/`}><span class="ot-label">Newer</span>{newer.data.title}</a>}
		</nav>
	</article>
</BaseLayout>

<style>
	.post {
		padding-top: 3rem;
	}
	header {
		max-width: 46rem;
	}
	.back {
		font-size: 0.9rem;
		text-decoration: none;
	}
	h1 {
		margin: 1rem 0 0;
		font-size: clamp(2.2rem, 5vw, 3.2rem);
	}
	.lead {
		margin: 1rem 0 0;
		font-size: 1.15rem;
		color: var(--ot-muted);
	}
	.byline {
		margin: 1.25rem 0 0;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin: 0.9rem 0 0;
		padding: 0;
		list-style: none;
		font: 500 0.8rem/1 var(--ot-font-mono);
	}
	.tags a {
		text-decoration: none;
	}
	.cover {
		display: block;
		width: 100%;
		max-width: 46rem;
		height: auto;
		margin-top: 2rem;
		border: 1px solid var(--ot-line);
		border-radius: 0.25rem;
	}
	.body {
		display: grid;
		gap: 2rem;
		margin-top: 2rem;
	}
	.toc ul {
		margin: 0.75rem 0 0;
		padding: 0;
		list-style: none;
		font-size: 0.9rem;
	}
	.toc li + li {
		margin-top: 0.5rem;
	}
	.toc a {
		color: var(--ot-muted);
		text-decoration: none;
	}
	.toc a:hover {
		color: var(--ot-accent);
	}
	@media (min-width: 64rem) {
		.body {
			grid-template-columns: minmax(0, 46rem) 1fr;
		}
		.toc {
			position: sticky;
			top: 6rem;
			align-self: start;
		}
	}
	.pager {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		max-width: 46rem;
		margin-top: 4rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--ot-line);
	}
	.pager a {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		text-decoration: none;
		font-weight: 500;
	}
	.pager .next {
		text-align: end;
		margin-inline-start: auto;
	}
</style>
