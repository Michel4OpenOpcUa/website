---
import { Image } from 'astro:assets';
import { formatDate, readingTime, type Post } from '../../data/blog';

interface Props {
	posts: Post[];
}
const { posts } = Astro.props;
---

<ul class="ot-posts not-content">
	{posts.map((post) => (
		<li>
			<a href={`/blog/${post.id}/`} class="ot-post">
				{post.data.cover && (
					<Image src={post.data.cover.image} alt={post.data.cover.alt} width={480} class="cover" />
				)}
				<div class="meta">
					<span class="ot-label">
						<time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time> · {readingTime(post)} min read
					</span>
					<h3>{post.data.title}</h3>
					<p>{post.data.description}</p>
					{post.data.tags.length > 0 && (
						<ul class="tags">{post.data.tags.map((tag) => <li>#{tag}</li>)}</ul>
					)}
				</div>
			</a>
		</li>
	))}
</ul>

<style>
	.ot-posts {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
		gap: 1.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.ot-posts > li {
		margin: 0;
	}
	.ot-post {
		display: flex;
		flex-direction: column;
		height: 100%;
		border: 1px solid var(--ot-line);
		border-radius: 0.25rem;
		overflow: hidden;
		text-decoration: none;
		color: inherit;
		background: var(--ot-bg);
	}
	.ot-post:hover {
		border-color: var(--ot-accent);
	}
	.cover {
		width: 100%;
		height: 11rem;
		object-fit: cover;
		border-bottom: 1px solid var(--ot-line);
		background: var(--ot-surface);
	}
	.meta {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding: 1.1rem 1.2rem 1.25rem;
	}
	h3 {
		margin: 0;
		font-size: 1.4rem;
	}
	p {
		margin: 0;
		color: var(--ot-muted);
		font-size: 0.95rem;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin: 0.25rem 0 0;
		padding: 0;
		list-style: none;
		font: 500 0.75rem/1 var(--ot-font-mono);
		color: var(--ot-accent);
	}
</style>
