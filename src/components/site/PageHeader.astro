---
interface Props {
	label?: string;
	title: string;
	lead?: string;
}
const { label, title, lead } = Astro.props;
---

<div class="ot-pagehead">
	<div class="ot-container">
		{label && <span class="ot-label">{label}</span>}
		<h1>{title}</h1>
		{lead && <p>{lead}</p>}
		<slot />
	</div>
</div>

<style>
	.ot-pagehead {
		padding-block: 3.5rem 2.5rem;
		border-bottom: 1px solid var(--ot-line);
		margin-bottom: 2.5rem;
		background:
			linear-gradient(to bottom, transparent, var(--ot-bg)),
			repeating-linear-gradient(90deg, var(--ot-line) 0 1px, transparent 1px 48px),
			repeating-linear-gradient(0deg, var(--ot-line) 0 1px, transparent 1px 48px);
	}
	.ot-label {
		color: var(--ot-accent);
	}
	h1 {
		margin: 0.6rem 0 0;
		font-size: clamp(2.2rem, 5vw, 3.2rem);
		font-weight: 700;
	}
	p {
		max-width: 44rem;
		margin: 1rem 0 0;
		font-size: 1.15rem;
		color: var(--ot-muted);
	}
</style>
