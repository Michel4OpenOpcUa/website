---
import Logo from './Logo.astro';
import { nav, site } from '../../data/site';

const year = new Date().getFullYear();
---

<footer class="ot-footer">
	<div class="ot-container ot-footer-inner">
		<div class="ot-footer-brand">
			<Logo size={28} />
			<p>Unified data for industrial operations.</p>
		</div>
		<nav aria-label="Footer">
			<ul>
				{nav.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
				<li><a href={site.github}>GitHub</a></li>
				<li><a href="/blog/rss.xml">RSS</a></li>
			</ul>
		</nav>
	</div>
	<div class="ot-container ot-footer-legal">
		<p>© {year} OT Fabric. Code is MIT-licensed unless a repository says otherwise.</p>
	</div>
</footer>

<style>
	.ot-footer {
		margin-top: 6rem;
		border-top: 1px solid var(--ot-line);
		background: var(--ot-surface);
		padding-block: 2.5rem 1.5rem;
	}
	.ot-footer-inner {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 2rem;
	}
	.ot-footer-brand p {
		margin: 0.75rem 0 0;
		color: var(--ot-muted);
		font-size: 0.9rem;
	}
	ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	ul a {
		color: var(--ot-fg);
		text-decoration: none;
		font-size: 0.95rem;
	}
	ul a:hover {
		color: var(--ot-accent);
	}
	.ot-footer-legal p {
		margin: 2rem 0 0;
		font-size: 0.8rem;
		color: var(--ot-muted);
	}
</style>
