---
import Logo from './Logo.astro';
import NavLinks from './NavLinks.astro';
import ThemeToggle from './ThemeToggle.astro';
import GitHubLink from './GitHubLink.astro';
---

<header class="ot-header">
	<div class="ot-container ot-header-inner">
		<Logo />
		<nav aria-label="Main" class="ot-header-nav">
			<NavLinks />
		</nav>
		<div class="ot-header-tools">
			<GitHubLink />
			<ThemeToggle />
			<details class="ot-menu">
				<summary aria-label="Menu">
					<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
				</summary>
				<nav aria-label="Main (mobile)" class="ot-menu-panel">
					<NavLinks class="vertical" />
				</nav>
			</details>
		</div>
	</div>
</header>

<style>
	.ot-header {
		position: sticky;
		top: 0;
		z-index: 10;
		background: var(--ot-header-bg);
		border-bottom: 1px solid var(--ot-line);
	}
	.ot-header-inner {
		display: flex;
		align-items: center;
		gap: 2rem;
		height: 4rem;
	}
	.ot-header-nav {
		display: none;
	}
	.ot-header-tools {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-inline-start: auto;
	}
	.ot-menu summary {
		list-style: none;
		cursor: pointer;
		display: inline-flex;
		color: var(--ot-fg);
	}
	.ot-menu summary::-webkit-details-marker {
		display: none;
	}
	.ot-menu-panel {
		position: absolute;
		inset-inline: 0;
		top: 4rem;
		padding: 1rem;
		background: var(--ot-header-bg);
		border-bottom: 1px solid var(--ot-line);
	}
	.ot-menu-panel :global(.vertical) {
		flex-direction: column;
		gap: 1rem;
	}
	@media (min-width: 50rem) {
		.ot-header-nav {
			display: block;
		}
		.ot-menu {
			display: none;
		}
	}
</style>
