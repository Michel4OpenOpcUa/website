---
// Mobile docs menu: site-wide navigation above Starlight's preferences.
import Default from '@astrojs/starlight/components/MobileMenuFooter.astro';
import NavLinks from '../site/NavLinks.astro';
---

<nav aria-label="Main" class="site-nav-mobile">
	<NavLinks class="vertical" />
</nav>
<Default />

<style>
	.site-nav-mobile {
		padding-block: 1rem;
		border-top: 1px solid var(--sl-color-gray-6);
	}
	.site-nav-mobile :global(.vertical) {
		flex-direction: column;
		gap: 0.9rem;
	}
</style>
